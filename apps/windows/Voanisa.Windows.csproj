<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Voanisa.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged: run the .exe straight from bin/ without MSIX for now. -->
    <WindowsPackageType>None</WindowsPackageType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.*" />
    <PackageReference Include="NAudio" Version="2.*" />
  </ItemGroup>

  <!-- The Rust core, built by build.ps1. Copied next to the exe so P/Invoke finds it. -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\Rust\target\release\voanisa_ffi.dll')">
    <Content Include="$(MSBuildThisFileDirectory)..\..\Rust\target\release\voanisa_ffi.dll"
             Link="voanisa_ffi.dll"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
