{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voanisa",
  "version": "1.0.7",
  "identifier": "org.macwave.VoanisaWeb",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "title": "Voanisa",
        "width": 1040,
        "height": 700,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/Music/Voanisa/**"]
      }
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
